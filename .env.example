# OpenAI API (for LM generation if used)
OPENAI_API_KEY=

# Disable LM rewriter (no OpenAI calls): set to 1 for evolution without API
# RAPBOT_DISABLE_LM_REWRITER=1

# Database (optional - set RAPBOT_USE_DB=1 to enable)
# Start MySQL: docker compose up -d
# Init schema: python scripts/init_db.py
RAPBOT_USE_DB=0
RAPBOT_DB_HOST=127.0.0.1
RAPBOT_DB_PORT=3307
RAPBOT_DB_USER=rapbot
RAPBOT_DB_PASSWORD=rapbot
RAPBOT_DB_NAME=rapbot
