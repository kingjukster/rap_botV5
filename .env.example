# OpenAI API (optional fallback for LM generation)
OPENAI_API_KEY=

# Groq free tier LM backend (fallback -- free, fast, OpenAI-compatible)
# Sign up at https://console.groq.com, create an API key
GROQ_API_KEY=

# RunPod vLLM endpoint (primary -- no rate limits, pay-per-use)
# Create at https://runpod.io/console/serverless using vLLM template
RUNPOD_API_KEY=
RAPBOT_REWRITER_API_BASE=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/openai/v1
RAPBOT_REWRITER_MODEL=qwen/qwen2.5-7b-instruct
RAPBOT_LM_RPM=120

# RunPod Serverless evolution workers
# Create at https://runpod.io/console/serverless with kingjukster77/rapbot-evo-worker:latest
RUNPOD_EVO_ENDPOINT_ID=

# Stable public URL (works from any network). Free at https://ngrok.com - add authtoken from dashboard.
# Without this, localtunnel is used (URL changes on each restart).
NGROK_AUTHTOKEN=

# Disable LM rewriter (no API calls): set to 1 for evolution without API
# RAPBOT_DISABLE_LM_REWRITER=1

# Database (optional - set RAPBOT_USE_DB=1 to enable)
# Start MySQL: docker compose up -d
# Init schema: python scripts/init_db.py
RAPBOT_USE_DB=0
RAPBOT_DB_HOST=127.0.0.1
RAPBOT_DB_PORT=3307
RAPBOT_DB_USER=rapbot
RAPBOT_DB_PASSWORD=rapbot
RAPBOT_DB_NAME=rapbot
